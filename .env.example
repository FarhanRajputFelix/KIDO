# ─── Database ──────────────────────────────────────────
# PostgreSQL (Required - use Neon, Supabase, or similar)
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# ─── Authentication ────────────────────────────────────
# Generate a secret: openssl rand -base64 32
AUTH_SECRET="your-auth-secret-here"

# ─── Google Gemini AI ──────────────────────────────────
# Required for AI chat, quiz generation, games, reports.
# MUST be a Google AI Studio key starting with "AIza" — get one at
# https://aistudio.google.com/apikey
GEMINI_API_KEY="your-gemini-api-key-here"

# ─── Email (Resend) — for signup verification codes ────
# Create a free key at https://resend.com/api-keys
RESEND_API_KEY="re_your_resend_api_key"
# Until you verify a domain in Resend, leave EMAIL_FROM unset to use the
# shared test sender (delivers only to your Resend account email).
# After verifying a domain: EMAIL_FROM="KIDO <noreply@yourdomain.com>"
EMAIL_FROM=""

# ─── Environment ───────────────────────────────────────
NODE_ENV="development"
NEXTAUTH_URL="http://localhost:3000"
