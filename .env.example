# ─── Database ──────────────────────────────────────────
# PostgreSQL (Required - use Neon, Supabase, or similar)
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# ─── Authentication ────────────────────────────────────
# Generate a secret: openssl rand -base64 32
AUTH_SECRET="your-auth-secret-here"

# ─── AI Provider ───────────────────────────────────────
# PRIMARY: Groq — free, NO credit card required. Get a key at
# https://console.groq.com/keys  (used for chat, tutor, quizzes, games, reports)
GROQ_API_KEY="your-groq-api-key-here"
# Optional model override (default: llama-3.3-70b-versatile)
# GROQ_MODEL="llama-3.3-70b-versatile"

# FALLBACK: Google Gemini (only used if GROQ_API_KEY is missing/failing).
# Must start with "AIza" — https://aistudio.google.com/apikey
GEMINI_API_KEY="your-gemini-api-key-here"

# Email verification is OPT-IN. Leave unset/false so signup works without email.
# Set "true" only after verifying a sending domain in Resend.
REQUIRE_EMAIL_VERIFICATION="false"

# ─── Email (Resend) — for signup verification codes ────
# Create a free key at https://resend.com/api-keys
RESEND_API_KEY="re_your_resend_api_key"
# Until you verify a domain in Resend, leave EMAIL_FROM unset to use the
# shared test sender (delivers only to your Resend account email).
# After verifying a domain: EMAIL_FROM="KIDO <noreply@yourdomain.com>"
EMAIL_FROM=""

# ─── Environment ───────────────────────────────────────
NODE_ENV="development"
NEXTAUTH_URL="http://localhost:3000"
